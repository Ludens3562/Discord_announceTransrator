# 翻訳BOTの環境変数テンプレート
# このファイルを app/.env にコピーし、実際の値を設定する。
# app/.env は .gitignore 済みのためコミットしないこと。

# Discord BOTトークン（必須）
BOT_TOKEN=

# DeepL APIキー（DeepLを使う場合に必須。未設定時はDeepLプロバイダーが無効化される）
DEEPL_API_KEY=

# 開発ギルドID（設定するとそのギルドにのみ即時コマンド同期する。省略時はグローバル同期）
DEV_GUILD_ID=

# PostgreSQL接続情報（必須）
# docker-compose 利用時、POSTGRES_HOST はサービス名 "db" を指定する。
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=disbot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=disbot
